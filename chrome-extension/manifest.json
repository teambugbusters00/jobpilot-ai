{
  "manifest_version": 3,
  "name": "JobPilot AI",
  "version": "2.0.0",
  "description": "AI-powered browser copilot for job discovery, job analysis, resume tailoring, and application form assistance.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["debugger", "tabs", "activeTab", "storage", "alarms", "scripting", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": {
    "default_path": "chat.html"
  },
  "action": {
    "default_title": "JobPilot AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "web_accessible_resources": [
    {
      "resources": ["vendor/pdfjs/*", "vendor/mammoth/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
